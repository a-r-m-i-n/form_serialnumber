{
    "name": "t3/form-serialnumber",
    "description": "Provides serial number finisher for EXT:form",
    "type": "typo3-cms-extension",
    "homepage": "https://bitbucket.org/t--3/form_serialnumber",
    "license": "GPL-2.0+",
    "authors": [
        {
            "name": "Thomas Hezel",
            "role": "Sponsor",
            "email": "thomas.hezel@zazudesign.de",
            "homepage": "https://www.zazudesign.de"
        },
        {
            "name": "Armin Vieweg",
            "role": "Developer",
            "email": "armin@v.ieweg.de",
            "homepage": "https://v.ieweg.de"
        }
    ],
    "require": {
        "php": "^8.1",
        "typo3/cms-core": "^12.4 || ^13.1",
        "typo3/cms-form": "^12.4 || ^13.1"
    },
    "require-dev": {
        "t3/cms": "^12.4",
        "friendsofphp/php-cs-fixer": "^2.18",
        "phpstan/phpstan": "^0.12.80",
        "jangregor/phpstan-prophecy": "^0.8",
        "saschaegerer/phpstan-typo3": "^0.13",
        "armin/editorconfig-cli": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "T3\\FormSerialnumber\\": "Classes"
        }
    },
    "replace": {
        "typo3-ter/form-serialnumber": "*"
    },
    "scripts": {
        "check": [
            "@ec",
            "@phpcs",
            "@phpstan"
        ],
        "fix": [
            "@ec:fix",
            "@phpcs:fix"
        ],
        "phpstan": "phpstan analyse -c Resources/Private/Build/phpstan.neon",
        "phpcs": "php-cs-fixer fix --config Resources/Private/Build/php-cs-rules.php --ansi --verbose --diff --dry-run",
        "phpcs:fix": "php-cs-fixer fix --config Resources/Private/Build/php-cs-rules.php --ansi",
        "ec": "ec -n -e .Build",
        "ec:fix": "ec -n -e .Build --fix"
    },
    "config": {
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "form_serialnumber",
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/public",
            "app-dir": ".Build"
        }
    }
}
